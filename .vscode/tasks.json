{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "f5-prep",
			"dependsOrder": "sequence",
			"dependsOn": ["kill-dotnet", "start-azurite", "build"],
			"problemMatcher": []
		},
		{
			"label": "kill-dotnet",
			"type": "shell",
			"command": "Get-Process dotnet -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0",
			"windows": {
				"command": "Get-Process dotnet -ErrorAction SilentlyContinue | Stop-Process -Force; exit 0"
			},
			"presentation": {
				"echo": false,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"close": true
			},
			"problemMatcher": []
		},
		{
			"label": "clean",
			"command": "dotnet",
			"windows": {
				"command": "${env:ProgramFiles}\\dotnet\\x64\\dotnet.exe"
			},
			"type": "process",
			"args": [
				"clean",
				"${workspaceFolder}/src/PoPunkouterSoftware.Api",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile"
		},
		{
			"label": "deep-clean",
			"detail": "Removes every bin/ and obj/ in the repo. `dotnet clean` leaves obj/ behind, so stale NuGet asset files and generated sources survive it — this is the task to run when a build misbehaves for no visible reason.",
			"type": "shell",
			"command": "Get-ChildItem -Path '${workspaceFolder}' -Recurse -Directory -Include bin,obj -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; exit 0",
			"windows": {
				"command": "Get-ChildItem -Path '${workspaceFolder}' -Recurse -Directory -Include bin,obj -ErrorAction SilentlyContinue | Remove-Item -Recurse -Force -ErrorAction SilentlyContinue; exit 0"
			},
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"close": true
			},
			"problemMatcher": []
		},
		{
			"label": "publish-release",
			"command": "dotnet",
			"windows": {
				"command": "${env:ProgramFiles}\\dotnet\\x64\\dotnet.exe"
			},
			"type": "process",
			"args": [
				"publish",
				"${workspaceFolder}/src/PoPunkouterSoftware.Api",
				"--configuration",
				"Release",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"dependsOn": "clean"
		},
		{
			"label": "build",
			"command": "dotnet",
			"windows": {
				"command": "${env:ProgramFiles}\\dotnet\\x64\\dotnet.exe"
			},
			"type": "process",
			"args": [
				"build",
				"${workspaceFolder}/src/PoPunkouterSoftware.Api/PoPunkouterSoftware.Api.csproj",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"problemMatcher": "$msCompile",
			"group": {
				"kind": "build",
				"isDefault": true
			}
		},
		{
			"label": "start-azurite",
			"type": "shell",
			"command": "docker compose up azurite -d",
			"options": { "cwd": "${workspaceFolder}" },
			"group": "build",
			"presentation": {
				"echo": true,
				"reveal": "silent",
				"focus": false,
				"panel": "shared",
				"close": true
			},
			"problemMatcher": []
		},
		{
			"label": "start-api-server",
			"type": "shell",
			"command": "dotnet watch run --project ${workspaceFolder}/src/PoPunkouterSoftware.Api/PoPunkouterSoftware.Api.csproj",
			"windows": {
				"command": "\"${env:ProgramFiles}\\dotnet\\x64\\dotnet.exe\" watch run --project ${workspaceFolder}/src/PoPunkouterSoftware.Api/PoPunkouterSoftware.Api.csproj"
			},
			"group": "build",
			"isBackground": true,
			"dependsOn": ["kill-dotnet", "start-azurite"],
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"label": "API Server (watch :8000)"
			},
			"problemMatcher": {
				"pattern": {
					"regexp": "^.*$",
					"file": 1,
					"location": 2,
					"message": 3
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": "^.*Now listening on.*$",
					"endsPattern": "^.*Application started.*$"
				}
			}
		},
		{
			"label": "test-unit",
			"command": "dotnet",
			"windows": {
				"command": "${env:ProgramFiles}\\dotnet\\x64\\dotnet.exe"
			},
			"type": "process",
			"args": [
				"test",
				"${workspaceFolder}/tests/PoPunkouterSoftware.Unit",
				"/property:GenerateFullPaths=true",
				"/consoleloggerparameters:NoSummary"
			],
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": "$msCompile",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "shared"
			}
		},
		{
			"label": "test-unit-watch",
			"type": "shell",
			"command": "dotnet watch test --project ${workspaceFolder}/tests/PoPunkouterSoftware.Unit",
			"windows": {
				"command": "\"${env:ProgramFiles}\\dotnet\\x64\\dotnet.exe\" watch test --project ${workspaceFolder}/tests/PoPunkouterSoftware.Unit"
			},
			"group": "test",
			"isBackground": true,
			"problemMatcher": "$msCompile",
			"presentation": {
				"echo": true,
				"reveal": "always",
				"focus": false,
				"panel": "dedicated",
				"label": "Tests (watch)"
			}
		}
	]
}
