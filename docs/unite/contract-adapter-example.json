{
  "_comment": "Proof that one brain can drive three bodies. Identical canonical role order for every creature. Each creature maps roles -> its own joints; absent roles are masked to 0 and PD-held at nominal. n_obs and n_action are derived by the generator, never hand-written.",

  "canonical_roles": [
    "hip_pitch_l", "hip_roll_l", "hip_yaw_l", "knee_l", "ankle_pitch_l", "ankle_roll_l", "toe_l",
    "hip_pitch_r", "hip_roll_r", "hip_yaw_r", "knee_r", "ankle_pitch_r", "ankle_roll_r", "toe_r",
    "waist_roll", "waist_yaw",
    "shoulder_pitch_l", "shoulder_roll_l", "shoulder_yaw_l", "elbow_l", "wrist_l",
    "shoulder_pitch_r", "shoulder_roll_r", "shoulder_yaw_r", "elbow_r", "wrist_r",
    "head_pitch", "head_yaw"
  ],
  "canonical_len": 28,

  "obs_block_per_role": [
    { "name": "joint_pos_rel", "size_per_role": 1, "scale": 1.0 },
    { "name": "joint_vel", "size_per_role": 1, "scale": 0.1 },
    { "name": "prev_action", "size_per_role": 1, "scale": 1.0 }
  ],
  "obs_common_blocks": [
    { "name": "base_ang_vel", "size": 3, "frame": "pelvis", "scale": 0.25 },
    { "name": "projected_gravity", "size": 3, "frame": "pelvis", "scale": 1.0 },
    { "name": "velocity_commands", "size": 3, "frame": "heading", "scale": 1.0 },
    { "name": "gait_phase", "size": 2, "scale": 1.0 },
    { "name": "role_mask", "size": 28, "scale": 1.0 },
    { "name": "morphology_onehot", "size": 8, "scale": 1.0 }
  ],
  "_obs_formula": "n_obs = 3 slots x 28 roles (=84) + 3+3+3+2+28+8 (=47) = 131, identical for every creature",

