<mujoco model="unitree_r1_a5_scene">
  <!-- standalone scene for unitree_r1_a5. GENERATED by tools/build_creatures.py.
       The option, keyframe and size blocks are the training scene's, copied verbatim. -->
  <compiler angle="radian" autolimits="true"/>
  <include file="creature.xml"/>
<option timestep="0.005" integrator="implicitfast" iterations="10" ls_iterations="20" />
  
  <keyframe>
    <key name="home" qpos="0 0 0.7332 1 0 0 0 -0.1 0 0 0.3 -0.2 0 -0.1 0 0 0.3 -0.2 0 0 0 0.35 0.18 0 0.87 0 0.35 -0.18 0 0.87 0 0 0"/>
  </keyframe>
  <!-- scene-level sensors / contacts moved out of creature.xml because they reference
       the floor or scene props that a portable creature does not own. -->
  <sensor>
    <framequat name="imu_quat" objtype="site" objname="imu" />
  </sensor>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.27 0.3" rgb2="0.15 0.16 0.18"
      markrgb="1 1 1" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>
  <worldbody>
    <light name="sun" pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" priority="1"
      friction="0.6" condim="3" contype="1" conaffinity="0"/>
  </worldbody>
</mujoco>
