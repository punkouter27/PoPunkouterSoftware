<mujoco model="go2_scene">
  <!-- standalone scene for go2. GENERATED by tools/build_creatures.py.
       The option, keyframe and size blocks are the training scene's, copied verbatim. -->
  <compiler angle="radian" autolimits="true"/>
  <include file="creature.xml"/>
  <keyframe>
    <key name="home" qpos="0 0 0.27 1 0 0 0 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8 0 0.9 -1.8"/>
  </keyframe>
  <!-- scene-level sensors / contacts moved out of creature.xml because they reference
       the floor or scene props that a portable creature does not own. -->
  <sensor>
    <framepos objtype="site" objname="imu" name="position" />
    <framezaxis objtype="site" objname="imu" name="upvector" />
    <framexaxis objtype="site" objname="imu" name="forwardvector" />
    <framelinvel objtype="site" objname="imu" name="global_linvel" />
    <frameangvel objtype="site" objname="imu" name="global_angvel" />
    <framequat objtype="site" objname="imu" name="orientation" />
    <framelinvel objtype="site" objname="FL_foot" name="FL_global_linvel" />
    <framelinvel objtype="site" objname="FR_foot" name="FR_global_linvel" />
    <framelinvel objtype="site" objname="RL_foot" name="RL_global_linvel" />
    <framelinvel objtype="site" objname="RR_foot" name="RR_global_linvel" />
    <framepos objtype="site" objname="FL_foot" name="FL_pos" reftype="site" refname="imu" />
    <framepos objtype="site" objname="FR_foot" name="FR_pos" reftype="site" refname="imu" />
    <framepos objtype="site" objname="RL_foot" name="RL_pos" reftype="site" refname="imu" />
    <framepos objtype="site" objname="RR_foot" name="RR_pos" reftype="site" refname="imu" />
  </sensor>

  <asset>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.25 0.27 0.3" rgb2="0.15 0.16 0.18"
      markrgb="1 1 1" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0"/>
  </asset>
  <worldbody>
    <light name="sun" pos="0 0 3" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane" priority="1"
      friction="0.6" condim="3" contype="1" conaffinity="0"/>
  </worldbody>
</mujoco>
