<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>low</NuGetAuditLevel>
  </PropertyGroup>
  <!-- Build stamp (Po web standard): YYMMDD, the UTC date of the HEAD commit, falling back to the
       UTC build date when git is unavailable. One generation path for every assembly: stamped as
       [AssemblyMetadata("BuildVersion")] and read by the client's Services/Ui/BuildStamp.cs (the
       .po-version corner stamp and /diag). git prints the commit time as Unix seconds (%ct),
       which has no time zone, and MSBuild turns it into the UTC date. CI checks out with
       fetch-depth 0. Pass -p:PoStamp=YYMMDD to pin it. Replaced the client csproj's
       DateTime.Now (local time, build date) on 2026-11-18. -->
  <Target Name="PoBuildStamp" BeforeTargets="GetAssemblyAttributes;CoreCompile">
    <Exec Condition="'$(PoStamp)' == ''" Command="git log -1 --format=%25ct" WorkingDirectory="$(MSBuildThisFileDirectory)"
          ConsoleToMsBuild="true" IgnoreExitCode="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_PoCommitSeconds" />
    </Exec>
    <PropertyGroup>
      <PoStamp Condition="'$(PoStamp)' == '' and $([System.Text.RegularExpressions.Regex]::IsMatch('$(_PoCommitSeconds)', '^\d+$'))">$([System.DateTime]::UnixEpoch.AddSeconds($(_PoCommitSeconds)).ToString('yyMMdd'))</PoStamp>
      <PoStamp Condition="'$(PoStamp)' == ''">$([System.DateTime]::UtcNow.ToString('yyMMdd'))</PoStamp>
    </PropertyGroup>
    <ItemGroup>
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>BuildVersion</_Parameter1>
        <_Parameter2>$(PoStamp)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>
</Project>
