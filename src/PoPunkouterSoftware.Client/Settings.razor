@page "/settings"
@rendermode WasmRenderModes.Interactive
@inject IJSRuntime JS

<PageTitle>PoPunkouterSoftware — Settings</PageTitle>

@* The fourth page — owner's call, 2026-10-19, reversing the deletion of an earlier /settings the
   same day. What makes this one different is the rule it keeps: it is the ONLY home of every
   visitor preference. The palette's theme/density/sound toggles went when it arrived, so no
   control exists twice; the palette keeps one "Go to Settings" row.
   Every default is the simplest choice. Nothing is stored on the server: each value is a
   localStorage key owned by the script that applies it (js/theme-kit.js `appSettings`). *@
<main id="main-content" class="app-page settings-page" tabindex="-1">
    <header>
        <h1>Settings</h1>
        <p class="app-note">Saved in this browser only. Every default is the simplest option.</p>
    </header>

    <section class="app-card settings-list" aria-label="Preferences">
        @foreach (var setting in All)
        {
            var titleId = $"setting-{setting.Key}";
            <div class="settings-row">
                <div class="settings-row__copy">
                    <h2 id="@titleId" class="app-card-title">@setting.Title</h2>
                    <p class="app-card-copy">@setting.Help</p>
                </div>
                <div class="app-segmented" role="group" aria-labelledby="@titleId">
                    @foreach (var choice in setting.Choices)
                    {
                        var active = _values[setting.Key] == choice.Value;
                        <button type="button" class="app-segmented__btn @(active ? "is-active" : "")"
                                aria-pressed="@(active ? "true" : "false")" disabled="@(!_ready)"
                                @onclick="e => SetAsync(setting.Key, choice.Value, e)">
                            @choice.Label
                        </button>
                    }
                </div>
            </div>
        }
    </section>
</main>

@code {
    private sealed record Choice(string Value, string Label);
    private sealed record Setting(string Key, string Title, string Help, Choice[] Choices);

    // Order matches appSettings.read(): theme|density|sound|fx|details. The first choice is the default.
    private static readonly Setting[] All =
    [
        new("theme", "Theme", "Follow your device, or pin light or dark.",
            [new("system", "System"), new("light", "Light"), new("dark", "Dark")]),
        new("density", "Density", "Compact fits more on a small screen.",
            [new("comfortable", "Comfortable"), new("compact", "Compact")]),
        new("sound", "Sound", "Click sounds, the rescan drone and the /azure Listen sonification.",
            [new("off", "Off"), new("on", "On")]),
        new("fx", "Effects", "Full adds the fluid, service flocks, uptime scars, the health orb and the palette jump. Uses more battery.",
            [new("simple", "Simple"), new("full", "Full")]),
        new("details", "Details", "Full adds the CI, page, package and exception chips on uptime rows, a performance trend on each app card, the /azure Listen button, and repo and GitHub Actions rows in Ctrl+K.",
            [new("simple", "Simple"), new("full", "Full")]),
    ];

    private readonly Dictionary<string, string> _values = All.ToDictionary(s => s.Key, s => s.Choices[0].Value);

    // The buttons stay disabled until the stored values are read, so a click can never act on
    // the defaults shown before the browser has said what is actually set.
    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            var stored = (await JS.InvokeAsync<string>("appSettings.read")).Split('|');
            for (var i = 0; i < All.Length && i < stored.Length; i++)
                if (All[i].Choices.Any(c => c.Value == stored[i]))
                    _values[All[i].Key] = stored[i];
            _ready = true;
        }
        catch (JSException)
        {
            // theme-kit.js did not load: the controls would have nothing to talk to.
        }
        StateHasChanged();
    }

    private async Task SetAsync(string key, string value, MouseEventArgs e)
    {
        _values[key] = value;
        // The click point is the origin of the theme's circular reveal.
        await JS.InvokeVoidAsync("appSettings.set", key, value, e.ClientX, e.ClientY);
    }
}
