@* A ranked horizontal bar list, in plain HTML and CSS.

   This replaces two <RadzenChart> instances on /azure. Radzen's chart is the right tool for
   a continuous series; both of these are a TOP-N RANKING — at most five cost drivers and six
   slow endpoints, arriving pre-sorted from the server — and for that it was the wrong shape
   three times over:

     · Cost. Each chart builds and re-lays-out an SVG scene graph on every render of its
       parent, which on this page meant once per SignalR progress tick during a 30-second
       scan. This component is a handful of divs whose only dynamic value is a width.
     · Mobile. RadzenChart carries a fixed pixel height and lays its category axis out
       horizontally, so at 390px the labels collided and the card needed an `overflow-x:auto`
       escape hatch that made the panel scroll sideways inside a page that must not. Bars run
       the other way: the label is a text column that truncates, and the panel's height is
       proportional to the row count. That is what lets the spend pane fit one screen.
     · Reading. A five-category bar chart with an axis, gridlines and a value scale spends
       most of its ink on furniture. The number that matters is printed on the row.

   The screen-reader summary stays with the caller (the .app-sr-only span on each panel), so
   nothing here is announced twice. *@
@using System.Globalization
@using PoPunkouterSoftware.Shared

<div class="metric-bars">
    @foreach (var point in Points)
    {
        <div class="metric-bar" title="@($"{point.Label}: {FormatValue(point.Value)}")">
            <span class="metric-bar__label">@point.Label</span>
            <span class="metric-bar__track" aria-hidden="true">
                <span class="metric-bar__fill @($"is-{Tone}")" style="@($"width:{Percent(point.Value)}%")"></span>
            </span>
            <span class="metric-bar__value">@FormatValue(point.Value)</span>
        </div>
    }
</div>

@code {
    /// <summary>Pre-sorted, pre-capped points. Rendered in the order given.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<OpsMetricPoint> Points { get; set; } = [];

    /// <summary>Bar colour band: <c>accent</c>, <c>warm</c> or <c>bad</c>.</summary>
    [Parameter] public string Tone { get; set; } = "accent";

    /// <summary>
    /// <c>money</c> renders USD, <c>ms</c> renders milliseconds, <c>count</c> renders a plain
    /// integer. A format STRING rather than a
    /// <c>Func&lt;double,string&gt;</c> on purpose: a lambda written in the caller's markup is a
    /// new object on every render, which would defeat the <see cref="ShouldRender"/> guard below
    /// and reintroduce exactly the re-render this component exists to stop.
    /// </summary>
    [Parameter] public string Format { get; set; } = "money";

    private IReadOnlyList<OpsMetricPoint>? _renderedPoints;
    private string? _renderedTone;
    private string? _renderedFormat;

    /// <summary>
    /// Bars are a pure projection of <see cref="Points"/>. The page replaces the whole
    /// <c>OpsSummary</c> on load rather than mutating its lists, so reference identity is a
    /// sound staleness test — the same contract <c>PortfolioStackTable</c> relies on.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_renderedPoints, Points) && _renderedTone == Tone && _renderedFormat == Format)
            return false;

        _renderedPoints = Points;
        _renderedTone = Tone;
        _renderedFormat = Format;
        return true;
    }

    /// <summary>
    /// Bars are scaled against the largest value present, not against a rounded axis maximum:
    /// the leader is always a full bar, so the row lengths read as "share of the worst" rather
    /// than as an absolute quantity the axis is no longer there to supply.
    /// </summary>
    private double Max => Points.Count == 0 ? 0 : Points.Max(p => p.Value);

    /// <summary>
    /// Floored at 2% so a non-zero value that rounds to nothing still draws a visible mark. A
    /// row present in the list is a row with a value; drawing it as empty would say otherwise.
    /// </summary>
    private double Percent(double value)
    {
        var max = Max;
        if (max <= 0) return 0;
        return Math.Max(2, Math.Round(value / max * 100, 2));
    }

    private string FormatValue(double value) => Format switch
    {
        "ms" => value.ToString("N0", CultureInfo.InvariantCulture) + " ms",
        "count" => value.ToString("N0", CultureInfo.InvariantCulture),
        _ => value.ToString("C2", CultureInfo.GetCultureInfo("en-US")),
    };
}
