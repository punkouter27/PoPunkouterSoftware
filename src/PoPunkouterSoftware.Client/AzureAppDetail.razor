@* One app, everything this site knows about it, in the drawer an uptime row name opens.

   Before this, one app's facts were spread over five places: its home-page card, its uptime
   row, a bar in "slowest endpoints" (only if it was in the top six), a line in "needs
   attention", and a row on /users. Nothing here is new data. The uptime row, response
   times, attention sentences and changes are the already-loaded OpsSummary; reach and own
   resource-group cost are /api/signins, fetched once, on the first drawer open of a visit,
   because that endpoint is a live Log Analytics query and most visits never open a drawer.

   Each fact once: the prose sentence carries uptime %, exceptions, deploy dates and bad days
   (it is DescribeUptimeRow, the same sentence the heatmap gives a screen reader), so the fact
   list holds only what the sentence does not. *@
@using PoPunkouterSoftware.Shared

<div class="azure-app-detail">
    <div class="azure-app-detail__status @($"is-{Latest}")">
        <span class="azure-app-detail__dot" aria-hidden="true"></span>
        <strong>@StatusLabel</strong>
        @if (StreakLabel is { } streak)
        {
            <span class="app-note">@streak</span>
        }
    </div>

    <div class="azure-app-detail__strip" style="@($"grid-template-columns: repeat({Row.Cells.Count}, minmax(0, 1fr));")" aria-hidden="true">
        @for (var i = 0; i < Row.Cells.Count; i++)
        {
            <div class="azure-uptime__cell @($"is-{Row.Cells[i]}") @(Row.DeployDays.Contains(i) ? "has-deploy" : "")"></div>
        }
    </div>
    <p class="azure-app-detail__prose">@DashboardDerivations.DescribeUptimeRow(Row, Days)</p>

    <dl class="azure-app-detail__facts">
        @if (ResponseMs is double ms)
        {
            <div><dt>Response time</dt><dd>@ms.ToString("N0") ms</dd></div>
        }
        <div>
            <dt>Sign-ins, 30 days</dt>
            <dd>@SignInLabel</dd>
        </div>
        @if (Row.PlanSku is { Length: > 0 } sku)
        {
            @* The Retail Prices API's monthly figure for each paid tier in this app's region
               and OS — "should this one move up?" with the number beside it. *@
            <div>
                <dt>Plan</dt>
                <dd>
                    @sku@(Row.TierOptions.Count > 0
                        ? " · " + string.Join(" · ", Row.TierOptions.Select(t => $"{t.Sku} ${t.MonthlyUsd:F0}/mo"))
                        : "")
                </dd>
            </div>
        }
        @if (Row.LastRun is { } run)
        {
            <div>
                <dt>Latest build</dt>
                <dd>
                    @if (run.Url is { Length: > 0 } url)
                    {
                        <a href="@url" target="_blank" rel="noopener noreferrer">@(run.Conclusion ?? "finished") · @run.CompletedAt.ToString("MMM d")</a>
                    }
                    else
                    {
                        @($"{run.Conclusion ?? "finished"} · {run.CompletedAt:MMM d}")
                    }
                </dd>
            </div>
        }
        @if (Row.Packages is { } packages)
        {
            <div>
                <dt>Packages</dt>
                <dd>@packages.Checked checked · @packages.Outdated.Count outdated · @packages.Vulnerable.Count vulnerable</dd>
            </div>
        }
        @* Only when the group billed something — the same rule as the /users cost column. *@
        @if (Reach is { Cost30Days: double cost and > 0 } reach)
        {
            <div>
                <dt>Own resource group, 30 days</dt>
                <dd>$@cost.ToString("F2")@(reach.CostPerPerson is double per && reach.People > 0 ? $" · ${per:F2} per person" : "")</dd>
            </div>
        }
    </dl>

    @if (Attention.Count > 0)
    {
        <section>
            <h3 class="azure-app-detail__heading">Needs attention</h3>
            <ul class="azure-app-detail__list">
                @foreach (var item in Attention) { <li>@item</li> }
            </ul>
        </section>
    }

    @if (Row.ErrorTypes.Count > 0)
    {
        @* Types only, never messages: messages can carry user data and this is anonymous. *@
        <section>
            <h3 class="azure-app-detail__heading">Exceptions, 24 hours</h3>
            <div class="app-table-scroll">
                <table class="app-table">
                    <thead><tr><th scope="col">Type</th><th scope="col">Count</th><th scope="col">First</th><th scope="col">Last</th></tr></thead>
                    <tbody>
                        @foreach (var e in Row.ErrorTypes)
                        {
                            <tr>
                                <td>@ShortType(e.Type)</td>
                                <td>@e.Count.ToString("N0")</td>
                                <td>@RelativeTime.Format(e.FirstSeen)</td>
                                <td>@RelativeTime.Format(e.LastSeen)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Row.Packages is { } pkgs && (pkgs.Vulnerable.Count > 0 || pkgs.Outdated.Count > 0))
    {
        <section>
            <h3 class="azure-app-detail__heading">Package updates</h3>
            <ul class="azure-app-detail__list">
                @foreach (var v in pkgs.Vulnerable) { <li><strong>Vulnerable:</strong> @v</li> }
                @foreach (var o in pkgs.Outdated.Take(8)) { <li>@o</li> }
                @if (pkgs.Outdated.Count > 8) { <li>and @(pkgs.Outdated.Count - 8) more</li> }
            </ul>
        </section>
    }

    @if (Changes.Count > 0)
    {
        <section>
            <h3 class="azure-app-detail__heading">Since the last scan</h3>
            <ul class="azure-app-detail__list">
                @foreach (var change in Changes) { <li>@change.Text@(change.Detail is { Length: > 0 } d ? $" ({d})" : "")</li> }
            </ul>
        </section>
    }

    <a class="azure-app-detail__link" href="/users">Everyone who signed in →</a>
</div>

@code {
    [Parameter, EditorRequired] public UptimeRow Row { get; set; } = new();
    [Parameter, EditorRequired] public IReadOnlyList<DateTime> Days { get; set; } = [];

    /// <summary>Only present when the app is in the summary's slowest-six list.</summary>
    [Parameter] public double? ResponseMs { get; set; }

    [Parameter] public IReadOnlyList<string> Attention { get; set; } = [];
    [Parameter] public IReadOnlyList<ScanChange> Changes { get; set; } = [];

    /// <summary>Null until the page's one /api/signins fetch completes.</summary>
    [Parameter] public SignInReport? SignIns { get; set; }

    /// <summary>"System.Net.Http.HttpRequestException" → "HttpRequestException": the namespace is noise in a 390px drawer.</summary>
    private static string ShortType(string type) => type[(type.LastIndexOf('.') + 1)..];

    // The latest probe, not today's worst-wins cell — the strip below already shows the day.
    private string Latest => Row.Current ?? UptimeState.NoData;

    private string StatusLabel => Latest switch
    {
        UptimeState.Healthy => "Up",
        UptimeState.Degraded => "Degraded",
        UptimeState.Broken => "Down",
        _ => "Not in the latest scan",
    };

    private string? StreakLabel => Row.CleanDays switch
    {
        null or 0 => null,
        var d when d >= Days.Count => $"no bad day in {Days.Count}+ days",
        var d => $"{DashboardDerivations.Plural(d.Value, "day")} since its last bad day",
    };

    private SignInAppReach? Reach => SignIns?.Apps.FirstOrDefault(a =>
        DashboardDerivations.AppMatchKey(a.App) == DashboardDerivations.AppMatchKey(Row.Name));

    private string SignInLabel => SignIns switch
    {
        null => "Loading…",
        { Available: false } => "Unavailable",
        _ when Reach is { } r => $"{(r.People == 1 ? "1 person" : $"{r.People} people")} · {DashboardDerivations.Plural(r.SignIns, "sign-in")}",
        _ => "None",
    };
}
