@namespace PoPunkouterSoftware.Client
@implements IDisposable
@inject NavigationManager Nav

<nav class="app-bottom-nav" aria-label="Mobile navigation">
    @foreach (var item in Items)
    {
        var active = IsActive(item.Href);
        <AuthorizeView>
            <Authorized>
                <a href="@item.Href"
           class="app-bottom-nav__item @(active ? "is-active" : null)"
           aria-current="@(active ? "page" : null)">
            <span class="material-symbols-outlined app-bottom-nav__icon" aria-hidden="true">@item.Icon</span>
            <span class="app-bottom-nav__label">@item.Label</span>
                </a>
            </Authorized>
            <NotAuthorized>
                @if (item.Href == "/")
                {
                    <a href="/" class="app-bottom-nav__item is-active"><span class="app-bottom-nav__label">Apps</span></a>
                }
            </NotAuthorized>
        </AuthorizeView>
    }
</nav>

@code {
    private sealed record NavItem(string Href, string Icon, string Label);

    private static readonly NavItem[] Items =
    [
        new("/", "home", "Apps"),
        new("/azure", "monitor_heart", "Azure"),
        new("/users", "group", "Users"),
        // No Settings slot (Po standard, 2026-11-18): settings is the gear in the header, on
        // every width, so a second settings control here was a duplicate.
    ];

    protected override void OnInitialized() =>
        Nav.LocationChanged += OnLocationChanged;

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) =>
        InvokeAsync(StateHasChanged);

    private bool IsActive(string href)
    {
        var current = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
        if (string.IsNullOrEmpty(current))
        {
            current = "/";
        }

        return string.Equals(current, href, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose() =>
        Nav.LocationChanged -= OnLocationChanged;
}
