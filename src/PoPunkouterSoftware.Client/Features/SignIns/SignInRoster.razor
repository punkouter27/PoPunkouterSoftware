@namespace PoPunkouterSoftware.Client
@* Everyone who has signed in, newest first — the answer to the question the page exists for.

   A plain <table>, not a RadzenDataGrid: the grid brings paging, sorting, virtualisation and
   a column-resize layer for what is a short, pre-sorted, read-only list, and its data-grid
   branch is the one the resource explorer already dropped. The table is wrapped in its own
   horizontal-scroll container by the page stylesheet, which is the one exception the
   "nothing scrolls sideways" rule allows.

   FIVE COLUMNS BECOME THREE ON A PHONE. "First seen" and "Last seen" are the two columns a
   visitor can most easily do without side by side, and dropping them is what lets the
   remaining three fit 390px — the alternative was 493px of table in a 339px box, measured
   on the running app, with the sign-in count and both dates off-screen behind a scroller
   that gave no hint it scrolled. The dates are not lost: `.signin-person__dates` repeats
   them under the person's name and is `display: none` at every viewport where the real
   columns exist, so exactly one copy is in the accessibility tree at any width and nothing
   is announced twice. *@
@using PoPunkouterSoftware.Shared

<table class="app-table">
    <caption class="app-sr-only">People who have signed in, most recent first</caption>
    <thead>
        <tr>
            <th scope="col">Person</th>
            <th scope="col">Apps</th>
            <th scope="col" class="is-numeric">Sign-ins</th>
            <th scope="col" class="is-date-col">First seen</th>
            <th scope="col" class="is-date-col">Last seen</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var person in People)
        {
            <tr @key="person.MaskedEmail + person.DisplayName">
                <th scope="row">
                    <span class="signin-person__name">@BreakAtSign(person.DisplayName)</span>
                    @* Same string twice when the provider sent no real name — see SignInFeed. *@
                    @if (person.MaskedEmail != person.DisplayName)
                    {
                        <span class="signin-person__email">@BreakAtSign(person.MaskedEmail)</span>
                    }
                    @* Phone-only stand-in for the two columns hidden below 640px. The
                       sr-only prefixes are what stop these reading as two bare relative
                       times with nothing to say what they are. *@
                    <span class="signin-person__dates">
                        <span>
                            <span class="app-sr-only">First seen </span>@RelativeTime.Format(person.FirstSeen)
                        </span>
                        <span>
                            <span class="app-sr-only">Last seen </span>@RelativeTime.Format(person.LastSeen)
                        </span>
                    </span>
                </th>
                <td>
                    <span class="signin-chips">
                        @foreach (var app in person.Apps)
                        {
                            <span class="signin-chip">@app</span>
                        }
                    </span>
                </td>
                <td class="is-numeric">@person.SignIns</td>
                @* The absolute instant is a hint rather than a `title`, so it is reachable by
                   tap as well as by mouse. Not Focusable: this is one hint per row per
                   column, and putting them all in the tab order would add two stops per
                   person to a page whose whole job is scanning a list. *@
                <td class="is-date-col">
                    <AppHint Text="@($"{person.DisplayName} first signed in at {person.FirstSeen:u}")">@RelativeTime.Format(person.FirstSeen)</AppHint>
                </td>
                <td class="is-date-col">
                    <AppHint Text="@($"{person.DisplayName} last signed in at {person.LastSeen:u}")">@RelativeTime.Format(person.LastSeen)</AppHint>
                </td>
            </tr>
        }
    </tbody>
</table>

@code {
    /// <summary>Pre-sorted by the server, newest sign-in first. Rendered in the order given.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<SignInPerson> People { get; set; } = [];

    private IReadOnlyList<SignInPerson>? _rendered;

    /// <summary>
    /// A masked address has no break opportunity, so at 390px one held the person column wide
    /// enough to push the sign-in count off the card. A &lt;wbr&gt; before the @ lets it wrap
    /// there — "pu*******6" / "@gmail.com" — instead of mid-domain.
    /// </summary>
    private static RenderFragment BreakAtSign(string text) => builder =>
    {
        var at = text.IndexOf('@');
        if (at <= 0)
        {
            builder.AddContent(0, text);
            return;
        }
        builder.AddContent(1, text[..at]);
        builder.AddMarkupContent(2, "<wbr>");
        builder.AddContent(3, text[at..]);
    };

    /// <summary>
    /// The roster is a pure projection of <see cref="People"/>, and the page REPLACES the
    /// whole report on every load rather than mutating its lists, so reference identity is a
    /// sound staleness test — the same contract MetricBars and PortfolioStackTable rely on.
    /// This component holds no internal state, which is what makes the guard safe: it is
    /// consulted on a component's own StateHasChanged too.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_rendered, People))
            return false;

        _rendered = People;
        return true;
    }
}
