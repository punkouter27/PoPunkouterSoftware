@namespace PoPunkouterSoftware.Client
@* The raw event feed — one row per sign-in, newest first.

   This is the one block on the page that is not an aggregate, and it earns its place for the
   question the roster cannot answer: "did that person just try it, or was that in March?"
   The roster collapses a person to a single LastSeen; this shows the individual visits, which
   is what you read when you are correlating a sign-in with a deploy or a link you sent.

   Collapsed by default because it is the longest block and the least often wanted. *@
@using PoPunkouterSoftware.Shared

<details class="app-disclosure">
    @* <h2>, not <strong> — see the note in SignInTrend.razor. It is the second of the two
       sections on this page that had no heading at all. *@
    <summary class="app-disclosure__heading">
        <span><RadzenIcon Icon="history" /><h2 class="app-disclosure__title">Most recent sign-ins</h2></span>
        <span class="app-note">@Events.Count @(Events.Count == 1 ? "event" : "events")</span>
    </summary>
    <div class="app-disclosure__body">
        @if (Events.Count == 0)
        {
            <div class="signin-empty">No sign-ins in this window.</div>
        }
        else
        {
            <table class="app-table">
                <caption class="app-sr-only">Individual sign-in events, most recent first</caption>
                <thead>
                    <tr>
                        <th scope="col">When</th>
                        <th scope="col">App</th>
                        <th scope="col">Person</th>
                        <th scope="col">Provider</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var e in Events)
                    {
                        <tr>
                            <td title="@e.Timestamp.ToString("u")">@RelativeTime.Format(e.Timestamp)</td>
                            <td><span class="signin-chip">@e.App</span></td>
                            <th scope="row">
                                <span class="signin-person__name">@e.DisplayName</span>
                                @* Providers that send no real name send the address as the
                                   display name, so both fields mask to the same string and the
                                   cell printed it twice. One line, not two. *@
                                @if (e.MaskedEmail != e.DisplayName)
                                {
                                    <span class="signin-person__email">@e.MaskedEmail</span>
                                }
                            </th>
                            <td>@(string.IsNullOrWhiteSpace(e.Provider) ? "—" : e.Provider)</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</details>

@code {
    /// <summary>Newest first, capped server-side at 100.</summary>
    [Parameter, EditorRequired] public IReadOnlyList<SignInEvent> Events { get; set; } = [];

    private IReadOnlyList<SignInEvent>? _rendered;

    /// <summary>Reference identity on the replaced-not-mutated list — see SignInRoster.</summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_rendered, Events))
            return false;

        _rendered = Events;
        return true;
    }
}
