@namespace PoPunkouterSoftware.Client
@using PoPunkouterSoftware.Client
@using Radzen

@* The ranked evidence list: every open item, most actionable first, each carrying the
   provenance that justifies it (source, confidence, owner, environment) plus a
   one-tap copy of the Azure CLI command that resolves it.

   No heading of its own: it renders INSIDE the page's "Needs attention" section, replacing
   that section's plain first-paint list once the full report has loaded. It used to be a
   second list further down under "Full priority queue", so every finding was listed twice
   on the same page — once as a sentence, once as a ranked row. *@
<div class="azure-priority-queue">
    @if (Items.Count == 0)
    {
        <div class="azure-compact-state success"><RadzenIcon Icon="check_circle" /> No immediate action is required.</div>
    }
    else
    {
        <div class="azure-attention-list">
            @foreach (var item in Items)
            {
                <article class="azure-attention-item" @key="@($"{item.Source}|{item.Item}")">
                    <div class="azure-item-heading">
                        <SeverityBadge Text="@item.Actionability" Style="@BadgeFor(item.Actionability)" />
                        <strong>@item.Item</strong>
                        <span class="azure-attention-reason">@item.Reason</span>
                        <span class="azure-impact-score">Impact @item.ImpactScore</span>
                    </div>
                    <div class="azure-attention-detail">
                        @* One provenance LINE, not a 2x2 grid of labelled tiles. The grid gave
                           four boxes the same visual weight as the finding itself and pushed every
                           item to ~200px, so seven open items were a 1400px scroll — and on live
                           data two of the four boxes read "unassigned" and "unknown" for most
                           rows, because Owner and Environment are inferred from a resource-group
                           name and usually cannot be inferred at all. Facts that are absent for
                           most items are not worth a permanent column: they are rendered only
                           when they actually say something. *@
                        <p class="azure-item-provenance">
                            <span>@item.Source</span>
                            <span>@item.Confidence confidence</span>
                            @if (!string.Equals(item.Owner, "unassigned", StringComparison.OrdinalIgnoreCase))
                            {
                                <span>owner @item.Owner</span>
                            }
                            @if (!string.Equals(item.Environment, "unknown", StringComparison.OrdinalIgnoreCase))
                            {
                                <span>@item.Environment</span>
                            }
                        </p>
                        <div class="azure-item-actions">
                            @if (!string.IsNullOrWhiteSpace(item.Command))
                            {
                                <button class="azure-copy-command" @onclick="@(() => OnCopyCommand.InvokeAsync(item.Command))"
                                        title="Copy Azure CLI command">
                                    <code>@item.Command</code><RadzenIcon Icon="content_copy" />
                                </button>
                            }
                            @if (CanRestart && item.Source == "Reliability")
                            {
                                @* One tap from "it is down" to "try turning it off and on again" —
                                   the server picks Start for a stopped site, Restart otherwise. *@
                                <button class="azure-action-button" @onclick="@(() => OnRestart.InvokeAsync(item))"
                                        title="Restart this App Service (starts it if it is stopped)">
                                    <RadzenIcon Icon="restart_alt" /><span>Restart</span>
                                </button>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PriorityQueueItem> Items { get; set; } = [];

    /// <summary>Maps an actionability tier to its badge style. Supplied by the page so the
    /// mapping stays in one place (AzureDashboard.Presentation) rather than forking here.</summary>
    [Parameter, EditorRequired] public Func<string?, BadgeStyle> BadgeFor { get; set; } = default!;

    [Parameter] public EventCallback<string> OnCopyCommand { get; set; }

    /// <summary>
    /// True when management actions are on (see <c>/api/config</c>). Restart is the same
    /// class of action as Rescan, so it shows under exactly the same condition.
    /// </summary>
    [Parameter] public bool CanRestart { get; set; }

    [Parameter] public EventCallback<PriorityQueueItem> OnRestart { get; set; }

    private IReadOnlyList<PriorityQueueItem>? _rendered;
    private bool _renderedCanRestart;

    /// <summary>
    /// Guarded on <see cref="Items"/> alone. The callback parameters are invoked, never
    /// rendered, and the two <c>Func</c>/<c>EventCallback</c> values are fresh objects on
    /// every parent render — including them would make the guard a no-op. The page rebuilds
    /// this list (RebuildDerivedState / ApplyResourceFilter) rather than mutating it, so a
    /// real change always arrives as a new reference. No state of its own.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_rendered, Items) && _renderedCanRestart == CanRestart) return false;
        _rendered = Items;
        _renderedCanRestart = CanRestart;
        return true;
    }
}

