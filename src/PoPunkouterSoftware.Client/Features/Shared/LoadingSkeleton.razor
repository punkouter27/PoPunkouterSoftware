@namespace PoPunkouterSoftware.Client
@* Shared loading skeleton (deduplicated from Index.razor and AzureDashboard.razor).
   Variant "cards"   — shimmering portfolio card tiles (auto-fit grid).
   Variant "summary" — Azure status placeholder: full-width header tile + 3-up grid. *@

@* role="status": aria-label is prohibited on a role-less div (axe, aria-prohibited-attr), and
   a loading placeholder IS a status region — the label is now actually announced. *@
<div class="loading-skeleton @(Variant == "summary" ? "is-summary" : "is-cards")" role="status" aria-label="@AriaLabel">
    @for (var i = 0; i < TileCount; i++)
    {
        <div></div>
    }
</div>

@code {
    [Parameter] public string Variant { get; set; } = "cards";
    [Parameter] public int TileCount { get; set; } = 6;
    [Parameter] public string AriaLabel { get; set; } = "Loading";
}
