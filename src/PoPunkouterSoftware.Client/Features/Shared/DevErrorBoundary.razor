@namespace PoPunkouterSoftware.Client
@inherits Microsoft.AspNetCore.Components.ErrorBoundaryBase

@* GoF: Template Method — dev vs prod error display is controlled by build configuration.
   DevErrorBoundary inherits from ErrorBoundaryBase to catch page-level unhandled exceptions. *@

@if (CurrentException is not null)
{
    <div class="dev-error-box">
        <RadzenText TextStyle="TextStyle.H5" class="dev-error-title">
            ⚠ Unhandled Error
        </RadzenText>

#if DEBUG
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true" class="rz-mb-2">
                <strong>@CurrentException.GetType().FullName</strong>: @CurrentException.Message
            </RadzenAlert>
            <details open class="dev-error-details">
                <summary class="dev-error-summary">Stack trace (dev only)</summary>
                <pre class="dev-error-stack">@CurrentException.ToString()</pre>
            </details>
#else
            <RadzenAlert AlertStyle="AlertStyle.Danger" ShowIcon="true">
                Something went wrong. Please refresh the page or contact support.
            </RadzenAlert>
#endif

        <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Light"
                      Size="ButtonSize.Small" Click="Recover" class="rz-mt-3" />
    </div>
}
else
{
    @ChildContent
}

@code {
    protected override Task OnErrorAsync(Exception exception)
    {
        Console.Error.WriteLine($"DevErrorBoundary caught exception: {exception}");
        return Task.CompletedTask;
    }
}
