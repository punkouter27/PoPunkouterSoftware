@namespace PoPunkouterSoftware.Client
@* A hint a touch user and a keyboard user can actually reach.

   WHY THIS EXISTS
   The app carries ~40 native `title` attributes, and the two most important classes of them
   are unreachable in practice: `title` never appears on a touch device at all, and it is not
   announced on focus, so a keyboard visitor never sees it either. That left the exact
   timestamp behind "Inventory updated 47m ago", the explanation behind "auto-updates every
   5 min", and the "this deployment is read-only, here is the flag that unlocks refresh"
   note visible only to a desktop mouse.

   Radzen's TooltipService is the mechanism, but its documented usage is
   `MouseEnter="@(args => tooltipService.Open(args, ...))"` on a Radzen component plus an
   ElementReference — per-call wiring that no component owning a plain `<span>` can borrow.
   This wraps it once: mouseenter and focus open it, mouseleave and blur close it, and a
   click/tap opens it, which is what makes it work on a phone.

   NO `title` IS RENDERED. Keeping one as a no-JS fallback would print a native tooltip
   underneath the Radzen one a second later — two tooltips for one fact. The fallback is
   not worth that; if the WASM runtime never loads, this app has no page at all, so a lost
   hint is not a new failure mode.

   `Text` is also the element's accessible description while open, but it is NOT
   `aria-label`: for the cases where this wraps text the visitor must still be able to read
   (a timestamp, a sentence), replacing the content with the hint would delete the content.

   With no child content it renders an ⓘ glyph instead — the home for methodology prose that
   used to sit on the page as a paragraph every visitor scrolled past. The text is then also
   in the tree as sr-only content, because an icon has no name of its own. *@
@inject TooltipService TooltipService
@implements IDisposable

<span class="app-hint @(ChildContent is null ? "app-hint--icon" : null) @Class"
      @ref="_element"
      tabindex="@(Focusable ? "0" : null)"
      @onmouseenter="Open"
      @onclick="Open"
      @onfocus="Open"
      @onmouseleave="Close"
      @onblur="Close">
    @if (ChildContent is null)
    {
        <span class="material-symbols-outlined" aria-hidden="true">info</span>@if (SpeakText)
        {<span class="app-sr-only">@Text</span>}
    }
    else
    {
        @ChildContent
    }
</span>

@code {
    /// <summary>The hint text. Also the accessible description of the trigger while open.</summary>
    [Parameter, EditorRequired] public string Text { get; set; } = "";

    /// <summary>
    /// Whether the trigger joins the tab order. Default false, deliberately: a hint attached
    /// to one of twelve catalogue cards would otherwise add twenty-four tab stops to the
    /// page. Set it on the few hints that carry information available nowhere else — those
    /// are the ones a keyboard visitor needs to reach.
    /// </summary>
    [Parameter] public bool Focusable { get; set; }

    /// <summary>Extra classes for the trigger, so an existing class on the element survives.</summary>
    [Parameter] public string? Class { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>
    /// Icon form only: whether the text is also in the tree as sr-only content (default true).
    /// Off for an ⓘ inside a table heading, which a screen reader repeats with every cell of
    /// that column — the caller must then say the same thing once somewhere else.
    /// </summary>
    [Parameter] public bool SpeakText { get; set; } = true;

    private ElementReference _element;
    private bool _open;

    private void Open()
    {
        if (_open) return;
        _open = true;
        TooltipService.Open(_element, Text, new TooltipOptions
        {
            Position = TooltipPosition.Top,
            // Null duration: this is an explanation, not a notification. It stays until the
            // visitor moves away or moves on, rather than vanishing mid-sentence.
            Duration = null
        });
    }

    private void Close()
    {
        if (!_open) return;
        _open = false;
        TooltipService.Close();
    }

    /// <summary>
    /// A tooltip left open over a component that is being torn down — the page's periodic
    /// refresh replaces the whole summary — would otherwise stay pinned to a detached
    /// element.
    /// </summary>
    public void Dispose()
    {
        if (_open) TooltipService.Close();
    }
}
