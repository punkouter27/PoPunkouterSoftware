@namespace PoPunkouterSoftware.Client
@using PoPunkouterSoftware.Shared
@using Radzen

@* The home page catalogue as a matrix: one row per app, one column per technical piece, so a
   visitor reads across a row to see how one app is made and down a column to compare all of
   them. It replaced a grid of screenshot cards (2026-11-03, owner's ask) that said what each
   app was but never what it was built from.

   A column that is empty on every row of this table is not drawn — the RL games have no
   backend, sign-in or delivery to list, and a column of dashes is noise, not information.
   A column IDENTICAL on every row is not drawn either: it moves into the "Shared by all N"
   strip above the table, so the grid shows only what differs (owner's ask, 2026-11-03).
   It is worked out per table on every new response, so the day one app changes backend,
   the Backend column comes back on its own. Only an IDENTICAL column moves: an "all but
   one, named as the exception" rule was tried for Sign-in and removed the same day (owner's
   call, 2026-11-03) — apps differ in sign-in, and some will drop login altogether, which a
   footnote would hide. What a shared column hid per app — SignalR,
   the Google Maps API — lives in the rightmost "Unique tech" column, which names the
   libraries and APIs only that app uses (three.js, LibGit2Sharp, WebLLM…).

   Cells are SHORT labels ("Table + Blob", "Azure OpenAI") so a column scans at a glance;
   the full wording is a hint on the cell (AppHint: hover, focus or tap) and sr-only text
   after it, so a screen reader gets it without the hint and without 100 extra tab stops.

   Above 640px it stays a real table: when the columns outgrow the card the card scrolls
   sideways and the app column stays pinned (owner's call, 2026-11-03 — comparing down a
   column was the point, and the 1200px stacking breakpoint took that away in any window
   narrower than a desktop). The scroller is tabindex="0" + role="group", the uptime grid's
   treatment, so a keyboard can scroll it. At 640px and below each row becomes a stacked
   block of label: value lines. Explicit table roles keep the semantics a `display: block`
   table otherwise loses in some browsers.

   ONE link per row: the app name, stretched over the row's app cell by `::after`. *@
<div class="app-card portfolio-stack" data-glass>
    @if (_shared.Length > 0)
    {
        @* Outside the scroller, so it stays put when the columns scroll sideways. *@
        <div class="portfolio-stack__shared">
            <span class="portfolio-stack__shared-title">Shared by all @Apps.Count @SectionHint("shared", speak: true)</span>
            <dl>
                @foreach (var shared in _shared)
                {
                    <div>
                        <dt>@shared.Label @SectionHint(shared.Key, speak: true)</dt>
                        <dd>@Hinted(shared.Value, shared.Detail, null)</dd>
                    </div>
                }
            </dl>
        </div>
    }
    <div class="portfolio-stack__scroll" tabindex="0" role="group" aria-label="@($"{Label}. Scrolls sideways when the columns do not fit.")">
    <table class="portfolio-stack__table" role="table" aria-label="@Label">
        @* What each column and Tech stack line means, once, for a screen reader — the ⓘ
           beside each heading is silent, or every cell would repeat its paragraph. *@
        <caption class="app-sr-only">@CaptionText</caption>
        <thead role="rowgroup">
            <tr role="row">
                <th scope="col" role="columnheader">App @SectionHint("app")</th>
                @foreach (var column in _columns)
                {
                    <th scope="col" role="columnheader">@column.Label @SectionHint(column.Key)</th>
                }
            </tr>
        </thead>
        <tbody role="rowgroup">
            @for (var i = 0; i < Apps.Count; i++)
            {
                var app = Apps[i];
                var first = i == 0 && FirstIsLcp;
                <tr @key="app.Id" role="row" class="portfolio-stack__row" data-sfx-hover="hover">
                    <th scope="row" role="rowheader" class="portfolio-stack__app">
                        @* The grid is on this wrapper, not the <th>: a display:grid cell stops
                           being a table cell, so it no longer stretches to the row's height and
                           the pinned column's opaque background ended halfway down the row. *@
                        <div class="portfolio-stack__app-grid">
                        @* width/height are the box the CSS draws (16:10), not the phone-shaped
                           source, so nothing shifts when the stylesheet arrives. The first row's
                           image is the LCP element and loads eagerly; the rest are lazy. *@
                        <div class="portfolio-stack__thumb" aria-hidden="true">
                            @if (!string.IsNullOrEmpty(app.ScreenshotUrl))
                            {
                                <img src="@app.ScreenshotUrl" alt="" width="160" height="100"
                                     loading="@(first ? "eager" : "lazy")" fetchpriority="@(first ? "high" : "auto")"
                                     decoding="async" onerror="this.style.display='none'" />
                            }
                        </div>
                        <div class="portfolio-stack__id">
                            <h2 class="portfolio-stack__name">
                                @if (string.IsNullOrWhiteSpace(app.Url))
                                {
                                    <AppHint Text="@AppSummary(app)">@app.Name</AppHint>
                                }
                                else
                                {
                                    @* The hint wraps the stretched link, so hovering anywhere on
                                       the app cell (picture included) shows the app summary. *@
                                    <AppHint Text="@AppSummary(app)"><a class="portfolio-stack__link" href="@app.Url" target="_blank" rel="noopener noreferrer" data-sfx="tap">@app.Name</a></AppHint>
                                }
                            </h2>
                            <div class="portfolio-stack__meta">
                                @* Live status only when it is news — see the streak beside it. *@
                                @if (app.Status is "unavailable" or "degraded")
                                {
                                    <RadzenBadge Text="@(app.Status == "unavailable" ? "Down" : "Degraded")" IsPill="true"
                                                 BadgeStyle="@(app.Status == "unavailable" ? BadgeStyle.Danger : BadgeStyle.Warning)" />
                                }
                                @if (app.CleanDays is > 0 and var days)
                                {
                                    <span class="portfolio-stack__streak">
                                        <RadzenIcon Icon="local_fire_department" /><span aria-hidden="true">@(days >= 30 ? "30d+" : $"{days}d")</span>
                                        <span class="app-sr-only">@(days >= 30 ? "No outage in 30 days" : $"{days} days without an outage")</span>
                                    </span>
                                }
                                @* Nightly PageSpeed Insights, mobile. A Details control: hidden
                                   unless /settings → Details → Full. *@
                                @if (app.Scores is { } scores)
                                {
                                    <ul class="portfolio-stack__scores" aria-label="PageSpeed Insights, mobile" data-detail>
                                        <li class="@ScoreClass(scores.Performance)"><span aria-hidden="true">Perf</span><span class="app-sr-only">Performance</span> @scores.Performance</li>
                                        <li class="@ScoreClass(scores.Accessibility)"><span aria-hidden="true">A11y</span><span class="app-sr-only">Accessibility</span> @scores.Accessibility</li>
                                        <li class="@ScoreClass(scores.BestPractices)"><span aria-hidden="true">BP</span><span class="app-sr-only">Best practices</span> @scores.BestPractices</li>
                                        <li class="@ScoreClass(scores.Seo)"><span aria-hidden="true">SEO</span><span class="app-sr-only">Search engine optimisation</span> @scores.Seo</li>
                                    </ul>
                                    @if (scores.PerformanceHistory.Count > 1)
                                    {
                                        var history = scores.PerformanceHistory;
                                        <span class="portfolio-stack__trend" data-detail>
                                            <Sparkline Points="@history.Select((p, n) => new OpsMetricPoint(n.ToString(), p)).ToList()"
                                                       Tone="@(history[^1] >= history[0] ? "good" : "warn")"
                                                       AriaLabel="@($"Performance over {history.Count} nights, from {history[0]} to {history[^1]}")" />
                                        </span>
                                    }
                                }
                            </div>
                        </div>
                        </div>
                        @* Below the picture, across the whole cell, never clamped: the space
                           under the thumbnail was empty, and a two-line clamp beside it cut
                           every description mid-sentence (owner's ask, 2026-11-03). *@
                        <p class="portfolio-stack__copy">@app.Description</p>
                        @if (app.SourceUrl is not null || app.PlayStoreUrl is not null)
                        {
                            @* Above the name's stretched link (z-index in the CSS), or the
                               whole-cell overlay would swallow these clicks. *@
                            <p class="portfolio-stack__links">
                                @if (app.SourceUrl is { } source)
                                {
                                    <a href="@source" target="_blank" rel="noopener noreferrer">Source code<span class="app-sr-only"> for @app.Name on GitHub</span></a>
                                }
                                @if (app.PlayStoreUrl is { } play)
                                {
                                    <a href="@play" target="_blank" rel="noopener noreferrer">Google Play<span class="app-sr-only">: @app.Name</span></a>
                                }
                            </p>
                        }
                    </th>
                    @foreach (var column in _columns)
                    {
                        var value = column.Value(app.Stack);
                        <td role="cell" data-label="@column.Label" class="@(value is null ? "is-empty" : null) @(column.Key is "ai" or "techstack" ? "is-wide" : null)">
                            @if (column.Key == "ai" && app.Stack.AiServices.Count > 0)
                            {
                                @* The AI column lists every model, grouped by where it runs:
                                   Azure, Google, In-app. A name is a hint saying what it is for;
                                   "optional" marks one wired in the code but off by default. *@
                                <ul class="portfolio-stack__ai">
                                    @foreach (var group in app.Stack.AiServices.GroupBy(a => a.Cloud))
                                    {
                                        <li>
                                            <AppHint Text="@(TechGlossary.Describe(group.Key) ?? group.Key)"><span class="portfolio-stack__cloud" data-cloud="@group.Key">@group.Key</span></AppHint>
                                            <ul>
                                                @foreach (var service in group)
                                                {
                                                    var use = service.Use.TrimEnd('.') + (service.Optional ? ". Optional: off unless configured." : ".");
                                                    <li class="@(service.Optional ? "is-optional" : null)">
                                                        <AppHint Text="@(TechGlossary.Hint(service.Name, use, app.Name) ?? use)" Class="portfolio-stack__hint">@service.Name</AppHint>@if (service.Optional)
                                                        {<span class="portfolio-stack__optional">optional</span>}<span class="app-sr-only">: @service.Use</span>
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    }
                                </ul>
                            }
                            else if (column.Key == "techstack")
                            {
                                @* Everything technical in one cell, as labelled lines: Frontend /
                                   Backend / Real-time / Data for a web app, Engine / Physics /
                                   RL training / Data for a game. Each line keeps its hint; RL training keeps its link
                                   to the training code. *@
                                <dl class="portfolio-stack__tech">
                                    @foreach (var part in TechParts(app.Stack))
                                    {
                                        var partHint = app.Stack.Details.GetValueOrDefault(part.Key);
                                        <div>
                                            <dt>@part.Label @SectionHint(part.Key == "frontend" && part.Label == "Engine" ? "engine" : part.Key)</dt>
                                            <dd>
                                                @if (part.Key == "training" && app.SourceUrl is { } repo && app.Stack.TrainingPath is { } folder)
                                                {
                                                    <AppHint Text="@(TechGlossary.Hint(part.Value, partHint, app.Name) ?? "Training code on GitHub")" Class="portfolio-stack__hint"><a class="portfolio-stack__cell-link" href="@($"{repo}/tree/HEAD/{folder}")" target="_blank" rel="noopener noreferrer">@part.Value<span class="app-sr-only">: training code on GitHub</span></a></AppHint>
                                                    @if (partHint is not null)
                                                    {
                                                        <span class="app-sr-only">: @partHint</span>
                                                    }
                                                }
                                                else if (part.Key == "data" && part.Value.Contains(" + "))
                                                {
                                                    @HintedList(part.Value, partHint, app.Name)
                                                }
                                                else
                                                {
                                                    @Hinted(part.Value, partHint, app.Name)
                                                }
                                            </dd>
                                        </div>
                                    }
                                </dl>
                            }
                            else if (value is null)
                            {
                                <span aria-hidden="true">–</span><span class="app-sr-only">None listed</span>
                            }
                            else if (column.Key == "extras" && value.Contains(" + "))
                            {
                                @HintedList(value, app.Stack.Details.GetValueOrDefault(column.Key), app.Name)
                            }
                            else
                            {
                                @Hinted(value, app.Stack.Details.GetValueOrDefault(column.Key), app.Name)
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<PortfolioApp> Apps { get; set; } = [];

    /// <summary>The table's accessible name, e.g. "Web applications".</summary>
    [Parameter, EditorRequired] public string Label { get; set; } = "";

    /// <summary>True for the table holding the page's LCP image — its first row loads eagerly.</summary>
    [Parameter] public bool FirstIsLcp { get; set; }

    /// <summary>Key is the property's camelCase JSON name, which is also its <see cref="AppStack.Details"/> key.
    /// <paramref name="Pinned"/>: always a column, in both tables, even when every row agrees —
    /// so the two tables open with the same four columns (owner's call, 2026-11-03).</summary>
    private sealed record Column(string Key, string Label, Func<AppStack, string?> Value, bool Pinned = false);

    private sealed record TechPart(string Key, string Label, string Value);

    /// <summary>The Tech stack cell's lines. A game (no backend, an RL training method) calls
    /// its frontend the engine.</summary>
    private static IEnumerable<TechPart> TechParts(AppStack s)
    {
        var game = s.Backend is null && s.Training is not null;
        (string Key, string Label, string? Value)[] parts =
        [
            ("frontend", game ? "Engine" : "Frontend", s.Frontend),
            ("backend", "Backend", s.Backend),
            ("realtime", "Real-time", s.Realtime),
            ("physics", "Physics", s.Physics),
            ("training", "RL training", s.Training),
            ("data", "Data", s.Data),
        ];
        return parts.Where(p => p.Value is not null).Select(p => new TechPart(p.Key, p.Label, p.Value!));
    }

    /// <summary>The same first three in both tables — Sign-in, Tech stack (Data included), AI — then the rest.</summary>
    private static readonly Column[] AllColumns =
    [
        new("signIn", "Sign-in", s => s.SignIn, Pinned: true),
        new("techstack", "Tech stack", s => TechParts(s).Any() ? string.Join(" | ", TechParts(s).Select(p => p.Value)) : null, Pinned: true),
        new("ai", "AI", s => s.Ai, Pinned: true),
        new("delivery", "Ships via", s => s.Delivery),
        // Last: what makes THIS app different, after the columns most apps share.
        new("extras", "Unique tech", s => s.Extras),
    ];

    private Column[] _columns = AllColumns;

    /// <summary>A column identical on every row, shown once above the table.</summary>
    private sealed record SharedValue(string Key, string Label, string Value, string? Detail);
    private SharedValue[] _shared = [];
    private IReadOnlyList<PortfolioApp>? _rendered;

    /// <summary>
    /// A pure projection of <see cref="Apps"/>, guarded on reference identity: the parent builds
    /// each list once per response, and replaces the response rather than mutating it.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_rendered, Apps)) return false;
        _rendered = Apps;
        return true;
    }

    protected override void OnParametersSet()
    {
        var present = AllColumns.Where(c => Apps.Any(a => c.Value(a.Stack) is not null)).ToArray();
        // Shared = every app has a value and it is the same one. One app is not a comparison.
        Column[] shared = Apps.Count > 1
            ? present.Where(c => !c.Pinned && Apps.All(a => Signature(c, a.Stack) is not null)
                                 && Apps.Select(a => Signature(c, a.Stack)).Distinct().Count() == 1).ToArray()
            : [];
        _columns = present.Except(shared).ToArray();
        _shared = shared.Select(c => Summarise(c, Apps[0].Stack)).ToArray();
    }

    /// <summary>What "the same" means for a column: the short value, or for AI the whole list
    /// of services — two apps that both say "Azure OpenAI" but call different models differ.</summary>
    private static string? Signature(Column column, AppStack stack) =>
        column.Key == "ai" && stack.AiServices.Count > 0
            ? string.Join("|", stack.AiServices.Select(s => $"{s.Cloud}:{s.Name}"))
            : column.Value(stack);

    /// <summary>The strip's entry: the value, with a hint only when every app agrees on that too.</summary>
    private SharedValue Summarise(Column column, AppStack first)
    {
        if (column.Key == "ai" && first.AiServices.Count > 0)
            return new(column.Key, column.Label, string.Join(", ", first.AiServices.Select(s => s.Name)),
                string.Join(" ", first.AiServices.Select(s => s.Use.TrimEnd('.') + ".")));
        var details = Apps.Select(a => a.Stack.Details.GetValueOrDefault(column.Key)).Distinct().ToArray();
        return new(column.Key, column.Label, column.Value(first)!, details is [{ } only] ? only : null);
    }

    // ── Hints (owner's ask, 2026-11-03: a tooltip on every section and every piece of text).
    // A value's hint is what it IS (TechGlossary) then how THIS app uses it (its stack.details
    // note). Only the app-specific note is also sr-only text: the glossary would add a
    // paragraph per cell to every screen-reader pass of the table.

    /// <summary>The ⓘ beside a column heading or a Tech stack line label. Silent to a screen
    /// reader, which repeats headings with every cell; the table's caption says it once.</summary>
    private static RenderFragment SectionHint(string key, bool speak = false) => __builder =>
    {
        if (!NoSectionIcon.Contains(key) && TechGlossary.Sections.GetValueOrDefault(key) is { } text)
        {
            <AppHint Text="@text" Class="portfolio-stack__section-hint" SpeakText="@speak" />
        }
    };

    private string CaptionText => string.Join(" ",
        new[] { "app" }.Concat(_columns.Select(c => c.Key))
            .Concat(Apps.SelectMany(a => TechParts(a.Stack)).Select(p => p.Key == "frontend" && p.Label == "Engine" ? "engine" : p.Key).Distinct())
            .Select(k => TechGlossary.Sections.GetValueOrDefault(k) is { } text ? $"{SectionName(k)}: {text}" : null)
            .OfType<string>());

    private string SectionName(string key) => key switch
    {
        "app" => "App",
        "engine" => "Engine",
        _ => _columns.FirstOrDefault(c => c.Key == key)?.Label
             ?? Apps.SelectMany(a => TechParts(a.Stack)).FirstOrDefault(p => p.Key == key)?.Label ?? key,
    };

    /// <summary>Sections whose name says enough on its own: no ⓘ (owner's call, 2026-11-03).
    /// Their meaning is still in the table's sr-only caption.</summary>
    private static readonly HashSet<string> NoSectionIcon = ["app", "signIn", "techstack", "frontend", "backend"];

    /// <summary>One value, underlined, with its hint.</summary>
    private static RenderFragment Hinted(string value, string? note, string? appName) => __builder =>
    {
        if (TechGlossary.Hint(value, note, appName) is { } text)
        {
            <AppHint Text="@text" Class="portfolio-stack__hint">@value</AppHint>
            @if (note is not null && note != value)
            {
                <span class="app-sr-only">: @note</span>
            }
        }
        else
        {
            @value
        }
    };

    /// <summary>"A + B + C" as one line each, each with its own "what it is" hint; the app's
    /// note covers the whole list, so it stays on one ⓘ after it. One wrapper, so on a phone
    /// (where the cell is a label | value grid) the list and its ⓘ stay together.</summary>
    private static RenderFragment HintedList(string value, string? note, string? appName) => __builder =>
    {
        <span class="portfolio-stack__multi">
            <ul class="portfolio-stack__lines">
                @foreach (var item in value.Split(" + "))
                {
                    <li>@Hinted(item, null, null)</li>
                }
            </ul>
            @if (note is not null)
            {
                <AppHint Text="@(appName is null ? note : $"In {appName}: {note}")" />
            }
        </span>
    };

    /// <summary>The app cell's hint: where the name goes, and how the app is doing.</summary>
    private static string AppSummary(PortfolioApp app)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(app.Url) && Uri.TryCreate(app.Url, UriKind.Absolute, out var url))
            parts.Add($"Opens the live app at {url.Host} in a new tab.");
        parts.Add(app.Status switch
        {
            "unavailable" => "It is down right now.",
            "degraded" => "It is up but degraded right now.",
            "healthy" => "It is up right now.",
            _ => "",
        });
        if (app.CleanDays is > 0 and var days)
            parts.Add(days >= 30 ? "No outage in the last 30 days." : $"{days} days without an outage.");
        if (app.SourceUrl is not null) parts.Add("Its source code is public on GitHub.");
        if (app.PlayStoreUrl is not null) parts.Add("It is on Google Play.");
        return string.Join(" ", parts.Where(p => p.Length > 0));
    }

    /// <summary>Lighthouse's own bands: 90+ good, 50–89 needs work, below 50 poor.</summary>
    private static string ScoreClass(int score) => score >= 90 ? "is-good" : score >= 50 ? "is-warn" : "is-bad";
}
