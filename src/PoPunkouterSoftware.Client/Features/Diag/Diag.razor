@namespace PoPunkouterSoftware.Client
@page "/diag"
@rendermode WasmRenderModes.Interactive
@using System.Diagnostics
@using PoPunkouterSoftware.Shared
@inject PortfolioApiClient Api

<PageTitle>System status</PageTitle>

@* System status (the Po /diag contract, see AGENTS.md). Anonymous in Production, so its only source is
   GET /api/diag (DiagReportDto): statuses, latencies and fixed text built server-side by DiagStatusBuilder.
   Layout: one plain-words banner, then API, Data and Services; each row is label, purpose, status pill,
   latency and the problem or detail. *@
<main id="main-content" class="app-page diag-page po-diag" tabindex="-1">
    <header class="diag-header">
        <div>
            <h1>System status</h1>
            <p class="app-note">Whether the app, its data and the services it relies on are working right now.</p>
        </div>
        <RadzenButton Text="@(_loading ? "Checking…" : "Refresh")" Icon="refresh"
                      ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Small"
                      Disabled="@_loading" Click="LoadAsync" />
    </header>

    @if (_report is null)
    {
        <div class="diag-banner diag-banner--pending" role="status">
            <strong>Running the checks…</strong>
        </div>
        <LoadingSkeleton Variant="summary" TileCount="3" AriaLabel="Checking the app's dependencies" />
    }
    else
    {
        <div class="diag-banner diag-banner--@Tone(_report.Status)" role="status" data-status="@_report.Status">
            <strong>@Headline(_report)</strong>
            <span class="diag-meta">
                @_report.Environment · version v@(_report.Version) · checks took @Ms(_report.CheckedMs) ·
                checked @RelativeTime.FormatDetailed(DateTimeOffset.UtcNow - _report.CheckedAt)
            </span>
        </div>

        @Section("api", "API")
        @Section("data", "Data")
        @Section("service", "Services")
    }
</main>

@code {
    private DiagReportDto? _report;
    private bool _loading = true;
    private bool _inFlight;

    protected override Task OnInitializedAsync() => LoadAsync();

    // The Refresh button is disabled while _loading; the early return is the second guard
    // (a double-click can land before the disabled state renders).
    private async Task LoadAsync()
    {
        if (_inFlight)
            return;
        _inFlight = true;
        _loading = true;
        StateHasChanged();

        var watch = Stopwatch.StartNew();
        try
        {
            var report = await Api.GetDiagAsync();
            var roundTrip = Math.Round(watch.Elapsed.TotalMilliseconds, 1);
            // The API row's latency is what this page waited for the answer.
            _report = report is null
                ? Unreachable("It sent an empty answer.", roundTrip)
                : report with
                {
                    Checks = [.. report.Checks.Select(c => c.Group == "api"
                        ? c with { Detail = "Answered this page's request.", LatencyMs = roundTrip }
                        : c)],
                };
        }
        catch (Exception ex)
        {
            _report = Unreachable(
                $"The server did not answer ({FriendlyError.Describe(ex)}). Check your connection and press Refresh.",
                Math.Round(watch.Elapsed.TotalMilliseconds, 1));
        }
        finally
        {
            _loading = false;
            _inFlight = false;
        }
    }

    /// <summary>What the page shows when the API itself cannot be reached: one unhealthy API row.</summary>
    private static DiagReportDto Unreachable(string problem, double ms) => new(
        "Unhealthy", "unknown", BuildStamp.Value, DateTimeOffset.UtcNow, ms,
        [new DiagCheckDto("server", "api", "App server", "Unhealthy", "Serves every page and all the data on them.",
            "Called from this page.", ms, problem)]);

    private RenderFragment Section(string group, string title) => __builder =>
    {
        var checks = _report!.Checks.Where(c => c.Group == group).ToList();
        <section class="diag-section po-diag__group" aria-labelledby="diag-@group">
            <h2 id="diag-@group" class="app-card-title">@title</h2>
            @if (checks.Count == 0)
            {
                <p class="app-note">Nothing in this group is checked by this server.</p>
            }
            @foreach (var check in checks)
            {
                <DiagRow Check="check" />
            }
        </section>
    };

    private static string Ms(double ms) => ms < 1 ? "under 1 ms" : $"{ms:0} ms";

    private static string Headline(DiagReportDto report)
    {
        var unhealthy = report.Checks.Where(c => c.Status == "Unhealthy").Select(c => c.Label).ToList();
        if (unhealthy.Count > 0)
            return $"Not working: {string.Join(", ", unhealthy)}";
        return report.Checks.Count(c => c.Status == "Degraded") switch
        {
            0 => "Everything is working",
            1 => "Working, with 1 thing degraded",
            var n => $"Working, with {n} things degraded",
        };
    }

    internal static string Tone(string status) => status switch
    {
        "Healthy" => "ok",
        "Degraded" => "warn",
        // Switched off on purpose: a neutral pill. Headline() counts only Degraded and Unhealthy, so Off
        // rows never change the banner.
        "Off" => "off",
        _ => "bad",
    };
}
