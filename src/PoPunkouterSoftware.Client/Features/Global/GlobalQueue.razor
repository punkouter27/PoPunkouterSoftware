@page "/global/queue"
@attribute [Authorize]
@rendermode WasmRenderModes.Interactive
@using PoPunkouterSoftware.Shared
@inject PortfolioApiClient Api
@inject LocalHelperClient Helper

<PageTitle>Training queue · PoPunkouterSoftware</PageTitle>

@* Replaces GLOBAL/station/pages/gpu_queue.html. The list is the committed snapshot, so it
   reads anywhere. Starting anything needs the PC: a job is a command on the owner's machine
   (GPU, venvs, Unity), or a tarball shipped from it to the cloud GPU, so the launch buttons
   appear only when the local helper is connected. The page sends job ids and hours; the
   helper takes every command from its own catalog. "Ready" is the crawl's check that every
   path in `requires` existed on the PC when the snapshot was taken. *@
<main id="main-content" class="app-page global-page" tabindex="-1">
    <header class="global-head">
        <div>
            <h1>Training queue</h1>
            <p class="app-note">
                Every training job, from <code>App_Data/global/config/train_jobs.json</code>. Jobs run on the PC's GPU or on the cloud GPU.
            </p>
        </div>
        @if (_queue?.Generated is not null)
        {
            <span class="global-stamp">checked @GlobalFormat.Ago(_queue.Generated)</span>
        }
    </header>

    <LocalHelperBar OnChanged="StateHasChanged" />

    @if (_loading)
    {
        <LoadingSkeleton Variant="cards" TileCount="6" AriaLabel="Loading training jobs" />
    }
    else if (_error is not null)
    {
        <div class="global-error" role="alert">@_error</div>
    }
    else if (_queue is null || _queue.Jobs.Count == 0)
    {
        <p class="app-empty-state">No training jobs yet. Run <code>python scripts/global/build_global_data.py --only queue</code>.</p>
    }
    else
    {
        <section class="global-kpis" aria-label="Job totals">
            <div class="global-kpi"><div class="v">@_queue.Jobs.Count</div><div class="l">jobs</div></div>
            <div class="global-kpi"><div class="v">@_queue.Jobs.Count(IsReady)</div><div class="l">ready to run</div></div>
            <div class="global-kpi"><div class="v">@_queue.Jobs.Count(IsBlocked)</div><div class="l">blocked</div></div>
            <div class="global-kpi"><div class="v">@_queue.Jobs.Count(NeedsGpu)</div><div class="l">need the GPU</div></div>
        </section>

        @if (Helper.IsConnected)
        {
            <section class="global-item" aria-label="Run on this PC">
                <div class="text"><strong>Run on this PC</strong> · @Picked.Count picked · @Hours(PickedHours) h</div>
                <p class="global-note">
                    Tick jobs below and set their hours. They run one after another in a new window on the PC; before each GPU job the
                    queue waits for the GPU to cool, and it keeps the PC awake.
                </p>
                <div class="global-actions">
                    <label class="global-field">Cool to °C
                        <input class="global-search global-num" type="number" min="40" max="90" value="@_coolTemp" @onchange="e => _coolTemp = Number(e, 70)" />
                    </label>
                    <label class="global-field">Gap between jobs, min
                        <input class="global-search global-num" type="number" min="0" max="120" value="@_gapMin" @onchange="e => _gapMin = Number(e, 5)" />
                    </label>
                    <label class="global-field">
                        <input type="checkbox" checked="@_refreshAfter" @onchange="e => _refreshAfter = e.Value is true" />
                        Refresh and push the snapshot when done
                    </label>
                </div>
                <div class="global-actions">
                    <button type="button" class="global-chip" disabled="@(_busy || Picked.Count == 0)" @onclick="() => Launch(dry: true)">Dry run (starts nothing)</button>
                    @if (_confirmLaunch)
                    {
                        <button type="button" class="global-chip is-on" disabled="@(_busy || Picked.Count == 0)" @onclick="() => Launch(dry: false)">
                            Yes, start @Picked.Count job(s) for @Hours(PickedHours) h
                        </button>
                        <button type="button" class="global-chip" @onclick="() => _confirmLaunch = false">Cancel</button>
                    }
                    else
                    {
                        <button type="button" class="global-chip" disabled="@(_busy || Picked.Count == 0)" @onclick="() => _confirmLaunch = true">Start on this PC…</button>
                    }
                    <button type="button" class="global-chip" disabled="@_busy" @onclick="ShowRuns">Recent runs</button>
                </div>
            </section>
        }

        @if (_output is not null)
        {
            <pre class="global-code global-output" role="status" aria-live="polite"><code>@_output</code></pre>
        }

        <ul class="global-list">
            @foreach (var job in _queue.Jobs)
            {
                var id = job.Id ?? "";
                <li class="global-item">
                    <div class="text">
                        @if (Helper.IsConnected)
                        {
                            <input type="checkbox" checked="@_picked.Contains(id)" disabled="@IsBlocked(job)"
                                   @onchange="e => Pick(id, e.Value is true)" aria-label="@($"Add {job.Label ?? id} to the queue")" />
                        }
                        <strong>@(job.Label ?? job.Id)</strong>
                        @if (IsBlocked(job))
                        {
                            <span class="global-tone is-bad">Blocked</span>
                        }
                        else if (IsReady(job))
                        {
                            <span class="global-tone is-good">Ready</span>
                        }
                        else
                        {
                            <span class="global-tone is-muted">Not checked</span>
                        }
                    </div>
                    <div class="meta">
                        <strong>@job.Repo</strong>
                        <span class="global-tags">
                            @if (job.Device is { Length: > 0 })
                            {
                                <span class="global-tag">@job.Device.ToUpperInvariant()</span>
                            }
                            @if (job.DefaultHours is { } hours)
                            {
                                <span class="global-tag">@Hours(hours) h default</span>
                            }
                            <span class="global-tag">@(job.SelfLimiting ? "stops itself" : "stopped by the queue")</span>
                        </span>
                        @if (Helper.IsConnected && _picked.Contains(id))
                        {
                            <label class="global-field">Hours
                                <input class="global-search global-num" type="number" min="0.1" max="24" step="0.5"
                                       value="@Hours(HoursFor(job))" @onchange="e => _hours[id] = Number(e, HoursFor(job))" />
                            </label>
                        }
                    </div>
                    @if (job.Command is { Length: > 0 })
                    {
                        <pre class="global-code"><code>@CommandText(job)</code></pre>
                    }
                    @if (job.Missing is { Count: > 0 })
                    {
                        <div class="meta">Missing on the PC: <span class="global-mono">@string.Join(", ", job.Missing)</span></div>
                    }
                    @if (job.After is { Length: > 0 })
                    {
                        <div class="meta">Afterwards: <span class="global-mono">@job.After</span></div>
                    }
                    @if (job.Source is { Length: > 0 })
                    {
                        <div class="meta">Command taken from <span class="global-mono">@job.Source</span></div>
                    }
                </li>
            }
        </ul>

        @if (_queue.CloudJobs.Count > 0)
        {
            <h2>Google Cloud GPU</h2>
            <p class="global-note">
                The same trainers on a rented NVIDIA L4, from <code>scripts/gcp/cloud_jobs.json</code>. The PC packs the repo and ships it,
                so this also needs the PC. A cloud run costs money for as long as the VM is up; stop the VM on
                <a href="/global/pc">This PC</a> when the job has finished.
            </p>
            <ul class="global-list">
                @foreach (var job in _queue.CloudJobs)
                {
                    var id = job.Id;
                    <li class="global-item">
                        <div class="text"><strong>@id</strong> <span class="global-tone is-info">Cloud</span></div>
                        <div class="meta">
                            <strong>@job.Source</strong>
                            @if (job.Hours is { } hours)
                            {
                                <span class="global-tags"><span class="global-tag">@Hours(hours) h default</span></span>
                            }
                        </div>
                        @if (job.Command is { Length: > 0 })
                        {
                            <pre class="global-code"><code>@job.Command</code></pre>
                        }
                        @if (Helper.IsConnected)
                        {
                            <div class="global-actions">
                                <label class="global-field">Hours
                                    <input class="global-search global-num" type="number" min="0.1" max="24" step="0.5"
                                           value="@Hours(CloudHoursFor(job))" @onchange="e => _cloudHours[id] = Number(e, CloudHoursFor(job))" />
                                </label>
                                <button type="button" class="global-chip" disabled="@_busy" @onclick="() => SendToCloud(job, dry: true)">Dry run (prints the commands)</button>
                                @if (_confirmCloud == id)
                                {
                                    <button type="button" class="global-chip is-on" disabled="@_busy" @onclick="() => SendToCloud(job, dry: false)">
                                        Yes, run @id on the cloud GPU for @Hours(CloudHoursFor(job)) h (costs money)
                                    </button>
                                    <button type="button" class="global-chip" @onclick="() => _confirmCloud = null">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="global-chip" disabled="@_busy" @onclick="() => _confirmCloud = id">Send to the cloud GPU…</button>
                                }
                            </div>
                        }
                    </li>
                }
            </ul>
        }
    }
</main>

@code {
    private readonly HashSet<string> _picked = new(StringComparer.Ordinal);
    private readonly Dictionary<string, double> _hours = new(StringComparer.Ordinal);
    private readonly Dictionary<string, double> _cloudHours = new(StringComparer.Ordinal);
    private GlobalQueueDto? _queue;
    private bool _loading = true;
    private string? _error;
    private string? _output;
    private string? _confirmCloud;
    private bool _busy;
    private bool _confirmLaunch;
    private bool _refreshAfter = true;
    private double _coolTemp = 70;
    private double _gapMin = 5;

    private List<GlobalTrainJobDto> Picked =>
        _queue?.Jobs.Where(j => j.Id is { } id && _picked.Contains(id)).ToList() ?? [];

    private double PickedHours => Picked.Sum(HoursFor);

    private static bool IsReady(GlobalTrainJobDto job) => job.Missing is { Count: 0 };

    private static bool IsBlocked(GlobalTrainJobDto job) => job.Missing is { Count: > 0 };

    private static bool NeedsGpu(GlobalTrainJobDto job) =>
        string.Equals(job.Device, "gpu", StringComparison.OrdinalIgnoreCase);

    private static string Hours(double hours) =>
        hours.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static string CommandText(GlobalTrainJobDto job) =>
        job.Cwd is { Length: > 0 } ? $"cd {job.Cwd}\n{job.Command}" : job.Command ?? "";

    private static double Number(ChangeEventArgs e, double fallback) =>
        double.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.Float,
            System.Globalization.CultureInfo.InvariantCulture, out var value) ? value : fallback;

    private double HoursFor(GlobalTrainJobDto job) =>
        job.Id is { } id && _hours.TryGetValue(id, out var hours) ? hours : job.DefaultHours ?? 1;

    private double CloudHoursFor(GlobalCloudJobDto job) =>
        _cloudHours.TryGetValue(job.Id, out var hours) ? hours : job.Hours ?? 1;

    private void Pick(string id, bool on)
    {
        _confirmLaunch = false;
        if (on)
            _picked.Add(id);
        else
            _picked.Remove(id);
    }

    private async Task Send(LocalHelperRequest request)
    {
        _busy = true;
        _output = "Working…";
        StateHasChanged();
        try
        {
            _output = (await Helper.SendAsync(request)).Output;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Launch(bool dry)
    {
        _confirmLaunch = false;
        await Send(new LocalHelperRequest
        {
            Action = "launch_queue",
            Name = "tonight",
            Dry = dry,
            CoolTemp = (int)_coolTemp,
            GapMin = (int)_gapMin,
            RefreshAfter = _refreshAfter,
            Jobs = Picked.Select(j => new LocalHelperQueueItem { Id = j.Id ?? "", Hours = HoursFor(j) }).ToList(),
        });
    }

    private Task ShowRuns() => Send(new LocalHelperRequest { Action = "queue_runs" });

    private async Task SendToCloud(GlobalCloudJobDto job, bool dry)
    {
        _confirmCloud = null;
        await Send(new LocalHelperRequest { Action = "cloud", Command = "run", Id = job.Id, Hours = CloudHoursFor(job), Dry = dry });
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
            _queue = await Api.GetGlobalQueueAsync(cts.Token);
        }
        catch (Exception ex)
        {
            _error = FriendlyError.Describe(ex);
        }
        finally
        {
            _loading = false;
        }
    }
}
