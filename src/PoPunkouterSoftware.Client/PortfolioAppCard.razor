@using PoPunkouterSoftware.Shared
@using Radzen

@* Stripped-down card per the design pass: only the screenshot, the app name, and a
   one-line description. Technology chips, action buttons, and "checked at" timestamps were
   removed so the grid reads as a clean visual catalogue rather than a dashboard tile. A
   status badge came back on 2026-10-19, but only for a card that is down or degraded.

   ONE link per card: the title, stretched over the whole card by `::after` (see
   PortfolioAppCard.razor.css). The screenshot and an "Open app" pill used to be two more
   anchors to the same URL — three links per card, two tab stops each, 24 tab stops for 12
   cards that all say "go to this app". The whole card is still the click target, and the
   host line under the description is the visible "this leaves the site" cue. *@
@* data-glass: js/gpu-backdrop.js collects this element's rect and the shader frosts the
   backdrop beneath it — see the [data-glass] block in modern-ui.css. data-sfx-hover: a
   delegated cue from js/audio-kit.js, silent unless the visitor turned sound on. Both are
   plain attributes on purpose; neither needs interop, a render hook or a dispose path. *@
<article class="app-card app-portfolio-card" data-glass data-sfx-hover="hover">
    @if (!string.IsNullOrEmpty(App.ScreenshotUrl))
    {
        <div class="app-screenshot-thumb">
            @* width/height advertise the box the CSS actually draws (aspect-ratio 16/10 on
               .app-screenshot-thumb), not the 390x844 phone-screenshot source. They disagreed,
               so before the stylesheet applied the browser reserved a 0.46-ratio box for a
               1.6-ratio element and every card jumped once — a self-inflicted CLS on a page
               whose whole job is showing pictures.

               The FIRST card is the LCP element and must not be lazy: `loading="lazy"` on it
               delays the largest paint by a full round trip for no benefit, since it is above
               the fold by definition. Every other card stays lazy. *@
            <img src="@App.ScreenshotUrl" alt="@($"Preview of {App.Name}")"
                 loading="@(IsFirst ? "eager" : "lazy")" fetchpriority="@(IsFirst ? "high" : "auto")"
                 decoding="async" width="1600" height="1000"
                 onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='grid';" />
            <div class="app-screenshot-thumb app-screenshot-thumb--missing" style="display:none; width:100%; height:100%;">
                <RadzenIcon Icon="image" />
                <span>Preview unavailable</span>
            </div>
        </div>
    }
    else
    {
        @* Fallback tile for the rare app whose screenshot is missing — a host that returns
           a non-2xx, a 0-byte file, or an entry in apps.json that the screenshotter cannot
           resolve to a URL. Without this the card renders an empty box that visibly breaks
           the grid rhythm (every other card has a 16:10 frame) and pulls the eye away from
           the working apps. A neutral placeholder with the same aspect ratio keeps the
           grid honest until the screenshotter catches up. *@
        <div class="app-screenshot-thumb app-screenshot-thumb--missing">
            <RadzenIcon Icon="image" />
            <span>Preview pending</span>
        </div>
    }
    <h2 class="app-card-title">
        @if (string.IsNullOrWhiteSpace(App.Url))
        {
            @App.Name
        }
        else
        {
            <a class="app-card-title-link" href="@App.Url" target="_blank" rel="noopener noreferrer" data-sfx="tap">@App.Name</a>
        }
    </h2>
    <p class="app-card-copy">@App.Description</p>
    @* Nightly PageSpeed Insights, mobile. Short labels on screen, full names for a screen
       reader — a `title` would be mouse-only (see AppHint), and four full category names do
       not fit one line of a 390px card. *@
    @if (App.Scores is { } scores)
    {
        <ul class="app-card-scores" aria-label="PageSpeed Insights, mobile">
            <li class="@ScoreClass(scores.Performance)"><span aria-hidden="true">Perf</span><span class="app-sr-only">Performance</span> @scores.Performance</li>
            <li class="@ScoreClass(scores.Accessibility)"><span aria-hidden="true">A11y</span><span class="app-sr-only">Accessibility</span> @scores.Accessibility</li>
            <li class="@ScoreClass(scores.BestPractices)"><span aria-hidden="true">BP</span><span class="app-sr-only">Best practices</span> @scores.BestPractices</li>
            <li class="@ScoreClass(scores.Seo)"><span aria-hidden="true">SEO</span><span class="app-sr-only">Search engine optimisation</span> @scores.Seo</li>
        </ul>
    }
    @* The streak shares the host line rather than adding one: a taller card fails
       Home_FirstScreen_ShowsAWholeCard at 390px. Days since the app's last bad day on the
       /azure uptime grid — the same row, so the two can never disagree. *@
    <div class="app-card-foot">
        @* Live status, on the foot line for the same reason as the streak. Only when it is
           news: a healthy card says so with its flame, and a status chip on all eleven would be
           eleven copies of "fine". This existed as a field on every card while the down app's
           card looked exactly like the others. *@
        @if (App.Status is "unavailable" or "degraded")
        {
            <RadzenBadge Text="@(App.Status == "unavailable" ? "Down" : "Degraded")" IsPill="true"
                         BadgeStyle="@(App.Status == "unavailable" ? BadgeStyle.Danger : BadgeStyle.Warning)" />
        }
        @if (App.CleanDays is > 0 and var days)
        {
            <span class="app-card-streak">
                <RadzenIcon Icon="local_fire_department" /><span aria-hidden="true">@(days >= 30 ? "30d+" : $"{days}d")</span>
                <span class="app-sr-only">@(days >= 30 ? "No outage in 30 days" : $"{days} days without an outage")</span>
            </span>
        }
        @* Nightly PageSpeed performance, last 30 nights, on this line rather than the chips'
           (five items wrapped to a second line at 300px). Draws nothing under two points. *@
        @if (App.Scores is { PerformanceHistory.Count: > 1 } trend)
        {
            var history = trend.PerformanceHistory;
            <span class="app-card-trend">
                <Sparkline Points="@history.Select((p, i) => new OpsMetricPoint(i.ToString(), p)).ToList()"
                           Tone="@(history[^1] >= history[0] ? "good" : "warn")"
                           AriaLabel="@($"Performance over {history.Count} nights, from {history[0]} to {history[^1]}")" />
            </span>
        }
        @if (Host is { } host)
        {
            <span class="app-card-host" aria-hidden="true"><RadzenIcon Icon="open_in_new" /><span class="app-card-host__name">@host</span></span>
        }
    </div>
</article>

@code {
    [Parameter, EditorRequired] public PortfolioApp App { get; set; } = default!;

    /// <summary>
    /// True for the first card in the grid, which is the page's LCP element. Drives the
    /// eager/high-priority image hints — see the note on the &lt;img&gt; above.
    /// </summary>
    [Parameter] public bool IsFirst { get; set; }

    private PortfolioApp? _rendered;

    /// <summary>
    /// The card is a pure projection of <see cref="App"/>. Blazor treats a reference-typed
    /// parameter as "may have changed" on every parent render, so without this guard any
    /// parent re-render walks all 23 cards. Identity comparison is sound here: the parent
    /// replaces the whole <c>PortfolioResponse</c> on reload rather than mutating apps.
    /// </summary>
    protected override bool ShouldRender()
    {
        if (ReferenceEquals(_rendered, App) && _renderedFirst == IsFirst) return false;
        _rendered = App;
        _renderedFirst = IsFirst;
        return true;
    }

    private bool _renderedFirst;

    /// <summary>
    /// The URL's host, for the "where this goes" line; null when there is no link. The shared
    /// <c>.azurewebsites.net</c> tail is dropped: it was identical on most cards and was the
    /// part a 280px card had room for least, so every host was cut mid-word.
    /// </summary>
    private string? Host => Uri.TryCreate(App.Url, UriKind.Absolute, out var uri)
        ? uri.Host.Replace(".azurewebsites.net", "", StringComparison.OrdinalIgnoreCase)
        : null;

    /// <summary>Lighthouse's own bands: 90+ good, 50–89 needs work, below 50 poor.</summary>
    private static string ScoreClass(int score) => score >= 90 ? "is-good" : score >= 50 ? "is-warn" : "is-bad";
}

