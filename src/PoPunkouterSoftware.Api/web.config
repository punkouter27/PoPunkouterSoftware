<?xml version="1.0" encoding="utf-8"?>
<!--
  Present for one reason: to strip the X-Powered-By header IIS adds on App Service.

  On Windows App Service the response leaves ASP.NET Core and then passes through IIS,
  which appends `X-Powered-By: ASP.NET` at the server level. Removing it in middleware
  looks like a fix and does nothing — the header is added downstream of the whole managed
  pipeline. Every other security header this app sends comes from Host/SecurityHeaders.cs;
  this one has to be here.

  `dotnet publish` transforms this file, injecting the <handlers> entry and the <aspNetCore>
  element for the app. Do not hand-write those — the transform overwrites them.
-->
<configuration>
  <system.webServer>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Powered-By" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
