<Router AppAssembly="@typeof(Program).Assembly"
        AdditionalAssemblies="@([typeof(PoPunkouterSoftware.Client.MainLayout).Assembly])">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(PoPunkouterSoftware.Client.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    @* Reachable only from client-side navigation, which this app barely does — a real
       browser navigation to an unmatched path is served by NotFoundPage's own
       `@page "/{*path}"` catch-all route, because a `MapFallback` in Program.cs used to
       answer it with JSON before the router ever ran. Both paths now render the same
       component, so there is one 404 markup to keep honest.

       It has an <h1> and carries #main-content, which the inline "Sorry, there's nothing
       at this address." paragraph did not: the skip link in MainLayout pointed at nothing
       and <FocusOnNavigate Selector="h1"> had nothing to focus. *@
    <NotFound>
        <PageTitle>Not found · PoPunkouterSoftware</PageTitle>
        <LayoutView Layout="@typeof(PoPunkouterSoftware.Client.MainLayout)">
            <NotFoundPage />
        </LayoutView>
    </NotFound>
</Router>
